{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MergeMark",
  "version": "0.9.3",
  "identifier": "com.mergemark.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "MergeMark",
        "width": 1200,
        "height": 800,
        "minWidth": 640,
        "minHeight": 500
      }
    ],
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/**/*", "$RESOURCE/**/*"]
      },
      "csp": "default-src 'self' tauri: https://openrouter.ai; img-src 'self' tauri: asset: data: blob:; style-src 'self'; script-src 'self'; worker-src 'self' blob:;"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEFDMUU1OTMzQkZFODE3RTcKUldUbkYraS9NMWtlckNFUU9Vb3p3Y25iMmhMS29XdWtEbFRTeWJvM1hMTmZzcjcweDNIWnRDNnkK"
    }
  }
}