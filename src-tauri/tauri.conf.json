{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MergeMark",
  "version": "0.9.2",
  "identifier": "com.mergemark.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "MergeMark",
        "width": 1200,
        "height": 800
      }
    ],
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/**/*", "$RESOURCE/**/*"]
      },
      "csp": "default-src 'self' tauri: http://localhost:11434 https://api.openai.com https://api.anthropic.com https://generativelanguage.googleapis.com; img-src 'self' tauri: asset: data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-eval' 'unsafe-inline'; worker-src 'self' blob:;"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "frameworks": [
        "./libs/libpdfium.dylib"
      ],
      "entitlements": "Entitlements.plist"
    },
    "resources": {
      "libs/*": "libs/"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEE1OUIyMzkyMjA1M0JDRTIKUldUaXZGTWdraU9icFlxRnkvWlJsUVhILzRob0FFYzlRR1phZHFBSWVmWmxIRVhUMmZWbm5ISmsK",
      "endpoints": [
        "https://github.com/badma025/MergeMark/releases/latest/download/latest.json"
      ]
    }
  }
}
