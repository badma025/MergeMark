{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MergeMark",
  "identifier": "com.mergemark.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "MergeMark",
        "width": 1200,
        "height": 800,
        "minWidth": 640,
        "minHeight": 500,
        "theme": "Dark",
        "backgroundColor": [9, 9, 11, 255]
      }
    ],
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/**/*", "$RESOURCE/**/*"]
      },
      "dangerousDisableAssetCspModification": ["style-src"],
      "csp": "default-src 'self' tauri:; connect-src 'self' tauri: ipc: http://ipc.localhost asset: http://asset.localhost; img-src 'self' tauri: asset: http://asset.localhost data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-eval' 'unsafe-inline'; worker-src 'self' blob:;"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDUxMDg4MzA2RjU0OEFDMDcKUldRSHJFajFCb01JVWJENTlvWFkxMkpZUEtCWHFGNnFxRWZpMEU4NHZIMVFPNi9JUGxFZzI3bkUK",
      "endpoints": ["https://github.com/badma025/MergeMark/releases/latest/download/latest.json"]
    }
  }
}
