# MergeMark environment configuration (example)
#
# MergeMark is fully offline: the app makes no AI or network requests of any
# kind and needs no key to import a paper. Nothing here is required to build
# or run it.
#
# The variables below belonged to the retired hosted-parsing experiments and
# are kept only so old developer scripts have documented names. Leave them
# empty unless you are reviving that code.

DATALAB_API_KEY=
DATALAB_PROCESSOR_ID=
DATALAB_API_URL=

LLAMAPARSE_API_KEY=
LLAMAPARSE_API_URL=
